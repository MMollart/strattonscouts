# ---------------------------------------------------------------------------
# Example environment variables / secrets for Stratton Scouts booking platform.
# Copy to `.dev.vars` for local development (NEVER commit `.dev.vars`).
# In production set these via `wrangler pages secret put <NAME>`.
# ---------------------------------------------------------------------------

# Public application base URL (used in emails and password reset links)
APP_BASE_URL="http://localhost:5173"

# Transactional email provider (e.g. Resend, Postmark, SendGrid). Configurable.
EMAIL_PROVIDER="console"          # "console" (dev log), "office365" or "resend"
EMAIL_API_KEY=""                   # provider API key; Office 365: client secret (SECRET)
EMAIL_FROM="bookings@strattonscouts.example"  # Office 365: the sending mailbox
MS_TENANT_ID=""                    # Office 365 only: directory (tenant) ID
MS_CLIENT_ID=""                    # Office 365 only: application (client) ID

# Secret used to sign/verify data at rest (e.g. encrypting contact info). SECRET.
DATA_ENCRYPTION_KEY=""

# Secret used when bootstrapping the initial Super Admin account. SECRET.
BOOTSTRAP_ADMIN_TOKEN=""
